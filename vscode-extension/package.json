{
	"name": "omp-ide-context-vscode",
	"displayName": "OMP IDE Context",
	"description": "Writes the active editor state to .omp/ide-context.json so the OMP extension can auto-inject it into every prompt. No network, no shell, no telemetry.",
	"version": "0.1.3",
	"private": true,
	"license": "MIT",
	"publisher": "omp-safe-ide-context",
	"repository": {
		"type": "git",
		"url": "https://github.com/nhathoagn/omp-ide-context.git"
	},
	"engines": {
		"vscode": "^1.125.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "ompIdeContext.showCurrent",
				"title": "OMP IDE Context: Show Current Context",
				"category": "OMP IDE Context"
			},
			{
				"command": "ompIdeContext.enable",
				"title": "OMP IDE Context: Enable",
				"category": "OMP IDE Context"
			},
			{
				"command": "ompIdeContext.disable",
				"title": "OMP IDE Context: Disable",
				"category": "OMP IDE Context"
			}
		],
		"configuration": {
			"title": "OMP IDE Context",
			"properties": {
				"ompIdeContext.enabled": {
					"type": "boolean",
					"default": false,
					"scope": "window",
					"description": "Capture the active editor for OMP. When disabled, this extension does not create workspace .omp files."
				}
			}
		}
	},
	"scripts": {
		"build": "tsc -p .",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^26.2.0",
		"@types/vscode": "^1.125.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "^7.0.2"
	}
}
